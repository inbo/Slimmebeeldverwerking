### Load the libraries ####
library(terra)
library(tidyterra)
### Load the datasets ####
base_dir <- "G:/Gedeelde drives/PRJ_SlimmeBeeldverwerking/PRJ_2026_SlimmeBeeldverwerking/Slimmebeeldverwerking/Bossenkansenkaart"
boshab <- rast(file.path(base_dir, "Boshabitat_referentielaag/BWK_2025_bosraster.tif"))
originalcrs <- crs(boshab)
#tile_grid <- vect(file.path(base_dir, "grids/512_pixel_grid.gpkg"))
block_grid <- vect(file.path(base_dir, "grids/50km_spatial_blok.gpkg"))
### Load Covariables ####
dtm <- rast("S:/Vlaanderen/Hoogte/DHMVII/DHMVIIDTMRAS1m.tif")
chm <- rast("S:/Vlaanderen/Hoogte/DHMVII/DHMVIInDSMRAS1m.tif")
targetcrs <- crs(dtm)
if (crs(boshab) != targetcrs) {
boshab <- project(boshab,targetcrs)
}
for (i in 1:nrow(block_grid)) {
#i <- 1
block_sel <- block_grid[i, ]
block_buffer <- buffer(block_sel,50) # create a 50 meter buffer
# crop reference layer
rast_crop <- crop(boshab, block_sel, mask = TRUE)
# crop covariables
chm_crop <- crop(chm, block_buffer, mask = TRUE)
# align rasters
# Step 1: Aggregate r2 from 1m to 10m by taking the maximum value (10x10 cell block)
chm_crop_median <- aggregate(chm_crop, fact = 10, fun = median)
# Step 2: Crop and align r2 to the exact extent, resolution, and origin of r1
chm_aligned <- resample(chm_crop_median, rast_crop, method = "near")
# Optional: Ensure the spatial extent is strictly clipped to r1's bounding box
chm_final <- crop(chm_aligned, rast_crop)
chm_final <- project(chm_final,originalcrs)
plot(chm_final)
newfolder <- paste0("block", i)
newpath <- file.path(output_base_path, newfolder)
dir.create(newpath, recursive = TRUE, showWarnings = FALSE)
outpath <- file.path(newpath, paste0("chm_median_block_", i, ".tif"))
writeRaster(
chm_final,
outpath,
gdal = c("COMPRESS=LZW"),
overwrite = TRUE)
}
install.packages("proxy", type = "binary")
install.packages("sf", type = "binary")
library(sf)
library(sf)
library(terra)
library(foreach)
library(doParallel)
# Define working directory and setup paths
setwd("G:/Gedeelde drives/PRJ_SlimmeBeeldverwerking/PRJ_2026_SlimmeBeeldverwerking/Slimmebeeldverwerking/Bossenkansenkaart/Boshabitat_covariabelen")
output_full <- "covariates_full_dataset"
output_vae  <- "covariates_VAE_dataset"
ref_dir     <- "G:/Gedeelde drives/PRJ_SlimmeBeeldverwerking/PRJ_2026_SlimmeBeeldverwerking/Slimmebeeldverwerking/Bossenkansenkaart/Boshabitat_referentielaag"
dir.create(output_full, showWarnings = FALSE, recursive = TRUE)
dir.create(output_vae,  showWarnings = FALSE, recursive = TRUE)
# 1. Load vector grid
grid_512 <- st_read("G:/Gedeelde drives/PRJ_SlimmeBeeldverwerking/PRJ_2026_SlimmeBeeldverwerking/Slimmebeeldverwerking/Bossenkansenkaart/grids/512_pixel_grid.gpkg")
raster_path <- "G:/Gedeelde drives/PRJ_SlimmeBeeldverwerking/PRJ_2026_SlimmeBeeldverwerking/Bewerkte covariabelen/predictors_ARD2.tif"
# 2. Map existing reference tiles
ref_files <- list.files(
path = ref_dir,
pattern = "^Reference_tile_id_.*\\.tif$",
full.names = TRUE,
recursive = TRUE
)
ref_ids <- gsub("^Reference_tile_id_(.*)\\.tif$", "\\1", basename(ref_files))
ref_map <- setNames(ref_files, ref_ids)
# 3. Setup Parallel Cluster
# Setting workers to 24 to leave headroom for OS overhead and disk I/O
num_cores <- 24
cl <- makeCluster(num_cores)
registerDoParallel(cl)
1+1
# 4. Parallel Loop Execution
foreach(
i = seq_len(nrow(grid_512)),
.packages = c("sf", "terra")
) %dopar% {
# Re-initialize SpatRaster inside worker (C++ pointers do not transfer across processes)
covariates_rast <- rast(raster_path)
poly <- grid_512[i, ]
poly_id <- as.character(poly$id)
# Convert geometry once for cropping
poly_vect <- vect(poly)
# --- Task 1: Crop and mask for full dataset ---
cov_full <- crop(covariates_rast, poly_vect, mask = TRUE)
out_full_path <- file.path(output_full, paste0("Covariates_tile_id_", poly_id, ".tif"))
writeRaster(cov_full, filename = out_full_path, overwrite = TRUE)
# --- Task 2: Process VAE dataset if a matching reference tile exists ---
if (poly_id %in% names(ref_map)) {
ref_tile <- rast(ref_map[[poly_id]])
# Align extent & resolution to reference tile
cov_aligned <- crop(covariates_rast, ref_tile, mask = TRUE)
cov_aligned <- resample(cov_aligned, ref_tile, method = "near")
# Mask pixels where reference tile == -1
cov_vae <- mask(cov_aligned, ref_tile == -1, maskvalues = TRUE)
out_vae_path <- file.path(output_vae, paste0("Covariates_vae_tile_id_", poly_id, ".tif"))
writeRaster(cov_vae, filename = out_vae_path, overwrite = TRUE)
}
}
