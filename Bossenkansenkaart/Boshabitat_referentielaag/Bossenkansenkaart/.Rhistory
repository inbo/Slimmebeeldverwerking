### Load the libraries ####
library(terra)
library(tidyterra)
### Load Covariables ####
bosw09 <- rast("//Client/G$/Gedeelde drives/PRJ_SlimmeBeeldverwerking/PRJ_2026_SlimmeBeeldverwerking/Bewerkte covariabelen/boswijzer/boswijzer2009.tif")
bosw12 <- rast("//Client/G$/Gedeelde drives/PRJ_SlimmeBeeldverwerking/PRJ_2026_SlimmeBeeldverwerking/Bewerkte covariabelen/boswijzer/boswijzer2009.tif")
### Load the datasets ####
base_dir <- "//Client/G$/Gedeelde drives/PRJ_SlimmeBeeldverwerking/PRJ_2026_SlimmeBeeldverwerking/Slimmebeeldverwerking/Bossenkansenkaart"
boshab <- rast(file.path(base_dir, "Boshabitat_referentielaag/BWK_2025_bosraster.tif"))
originalcrs <- crs(boshab)
#tile_grid <- vect(file.path(base_dir, "grids/512_pixel_grid.gpkg"))
block_grid <- vect(file.path(base_dir, "grids/50km_spatial_blok.gpkg"))
bosw09 <- rast("G:/Gedeelde drives/PRJ_SlimmeBeeldverwerking/PRJ_2026_SlimmeBeeldverwerking/Bewerkte covariabelen/boswijzer/boswijzer2009.tif")
### Load Covariables ####
bosw09 <- rast("//Client/G$/Gedeelde drives/PRJ_SlimmeBeeldverwerking/PRJ_2026_SlimmeBeeldverwerking/Bewerkte covariabelen/boswijzer/boswijzer2009.tif")
bosw12 <- rast("//Client/G$/Gedeelde drives/PRJ_SlimmeBeeldverwerking/PRJ_2026_SlimmeBeeldverwerking/Bewerkte covariabelen/boswijzer/boswijzer2009.tif")
bosw15 <- rast("//Client/S$/Vlaanderen/Natuur_Bos/Boswijzer_Groenkaart/Boswijzer_2015.tif")
bosw18 <- rast("//Client/S$/Vlaanderen/Natuur_Bos/Boswijzer_Groenkaart/Boswijzer_2018.tif")
bosw21 <- rast("//Client/S$/Vlaanderen/Natuur_Bos/Boswijzer_Groenkaart/Boswijzer_2021.tif")
NAflag(bosw09) <- 2
NAflag(bosw09) <- 255
NAflag(bosw12) <- 2
NAflag(bosw12) <- 255
NAflag(bosw15) <- 2
NAflag(bosw15) <- 255
NAflag(bosw18) <- 2
NAflag(bosw18) <- 255
NAflag(bosw21) <- 2
NAflag(bosw21) <- 255
targetcrs <- crs(bosw09) # crs bosw09 == bosw12, bosw18 == bosw21
if (crs(boshab) != targetcrs) {
boshab <- project(boshab,targetcrs)
}
if (crs(block_grid) != targetcrs) {
block_grid <- project(block_grid,targetcrs)
}
if (crs(bosw15) != targetcrs) {
bosw15 <- project(bosw15,targetcrs)
}
if (crs(bosw12) != targetcrs) {
bosw12 <- project(bosw12,targetcrs)
}
if (crs(bosw18) != targetcrs) {
bosw18<- project(bosw18,targetcrs)
}
if (crs(bosw21) != targetcrs) {
bosw21 <- project(bosw21,targetcrs)
}
### Set ouput path location ###
output_base_path <- file.path(base_dir, "Boshabitat_covariabelen/blocks")
for (i in 1:nrow(block_grid)) {
#i <- 1
block_sel <- block_grid[i, ]
block_buffer <- buffer(block_sel,50) # create a 50 meter buffer
# crop reference layer
rast_crop <- crop(boshab, block_sel, mask = TRUE)
# crop covariables
bos_crop <- crop(bosw09, block_buffer, mask = TRUE)
# align rasters
# Crop and align r2 to the exact extent, resolution, and origin of r1
bos_aligned <- resample(bos_crop, rast_crop, method = "near")
# Optional: Ensure the spatial extent is strictly clipped to r1's bounding box
bos_final <- crop(bos_aligned, rast_crop)
bos_final <- project(bos_final,originalcrs)
bos_final <- bos_final >= 0.5 # round my values to 1 or 0
newfolder <- paste0("block", i)
newpath <- file.path(output_base_path, newfolder)
dir.create(newpath, recursive = TRUE, showWarnings = FALSE)
outpath <- file.path(newpath, paste0("Boswijzer09_block_", i, ".tif"))
writeRaster(
bos_final,
outpath,
gdal = c("COMPRESS=LZW"),
overwrite = TRUE)
}
