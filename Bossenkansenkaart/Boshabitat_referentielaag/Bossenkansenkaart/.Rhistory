library(sf)
library(terra)
library(future)
library(future.apply)
library(progressr)
# 1. Set up parallel backend and progress handlers
num_workers <- 4
plan(multisession, workers = num_workers)
handlers(global = TRUE)
handlers("progress")
terraOptions(memfrac = 0.6, todisk = TRUE)
setwd("C:/Users/sebastiaan_verbessel/Downloads")
# Define directories and file paths
output_full <- "E:/covariates_full_dataset/"
dir.create(output_full, showWarnings = FALSE, recursive = TRUE)
# 2. Load grid and raster metadata
grid_512 <- st_read("512_pixel_grid.gpkg")
covariates_path <- "predictors_ARD2_filled.tif"
# Get CRS using a temporary raster object
cov_crs <- crs(rast(covariates_path))
# Ensure coordinate reference systems match (keep grid_512 as an sf object)
grid_512 <- st_transform(grid_512, cov_crs)
n_tiles <- nrow(grid_512)
poly_ids <- as.character(grid_512$id)
# Extract geometries as WKT text or keep sf object to safely pass to workers
# sf objects serialize safely across future background workers
grid_sf <- grid_512["id"]
# 3. Parallel Execution Function
process_tiles <- function() {
p <- progressor(steps = n_tiles)
future_lapply(seq_len(n_tiles), function(i) {
p() # Signal progress update
poly_id <- poly_ids[i]
out_full_path <- file.path(output_full, paste0("Covariates_tile_id_", poly_id, ".tif"))
# Skip if file already exists
if (file.exists(out_full_path)) return(NULL)
# Safely convert the sf polygon feature to SpatVector INSIDE the worker
poly_vect <- vect(grid_sf[i, ])
# Re-open raster pointer INSIDE the worker
cov_rast_worker <- rast(covariates_path)
# Crop & mask
cov_full <- crop(cov_rast_worker, poly_vect, mask = TRUE)
writeRaster(cov_full, filename = out_full_path, overwrite = TRUE)
# Memory cleanup inside worker
rm(cov_full, cov_rast_worker, poly_vect)
if (i %% 25 == 0) {
gc()
tmpFiles(current = TRUE, orphan = TRUE, old = TRUE, remove = TRUE)
}
return(NULL)
}, future.seed = TRUE)
}
# 4. Run process with progress bar
with_progress({
process_tiles()
})
library(sf)
library(terra)
library(future)
library(future.apply)
library(progressr)
# 1. Set up parallel backend and progress handlers
num_workers <- 4
plan(multisession, workers = num_workers)
handlers(global = TRUE)
handlers("progress")
terraOptions(memfrac = 0.6, todisk = TRUE)
setwd("C:/Users/sebastiaan_verbessel/Downloads")
# Define directories and file paths
output_full <- "E:/covariates_full_dataset/"
dir.create(output_full, showWarnings = FALSE, recursive = TRUE)
# 2. Load grid and raster metadata
grid_512 <- st_read("512_pixel_grid.gpkg")
covariates_path <- "predictors_ARD2_filled.tif"
# Get CRS and transform grid
cov_crs <- crs(rast(covariates_path))
grid_512 <- st_transform(grid_512, cov_crs)
n_tiles <- nrow(grid_512)
poly_ids <- as.character(grid_512$id)
# Extract geometries as standard WKT strings and CRS string
# (Plain strings serialize 100% reliably across parallel sessions)
wkt_geoms <- st_as_text(st_geometry(grid_512))
crs_str <- st_crs(grid_512)$wkt
# 3. Parallel Execution Function
process_tiles <- function() {
p <- progressor(steps = n_tiles)
future_lapply(seq_len(n_tiles), function(i) {
p() # Signal progress update
poly_id <- poly_ids[i]
out_full_path <- file.path(output_full, paste0("Covariates_tile_id_", poly_id, ".tif"))
# Skip if file already exists
if (file.exists(out_full_path)) return(NULL)
# Reconstruct SpatVector cleanly inside the worker from raw WKT text
poly_vect <- terra::vect(wkt_geoms[i], crs = crs_str)
# Open raster connection inside worker
cov_rast_worker <- terra::rast(covariates_path)
# Crop & mask
cov_full <- terra::crop(cov_rast_worker, poly_vect, mask = TRUE)
terra::writeRaster(cov_full, filename = out_full_path, overwrite = TRUE)
# Memory cleanup inside worker
rm(cov_full, cov_rast_worker, poly_vect)
if (i %% 25 == 0) {
gc()
terra::tmpFiles(current = TRUE, orphan = TRUE, old = TRUE, remove = TRUE)
}
return(NULL)
}, future.seed = TRUE, future.packages = c("terra", "sf"))
}
# 4. Run process with progress bar
with_progress({
process_tiles()
})
library(sf)
library(terra)
library(future)
library(future.apply)
library(progressr)
# 1. Set up parallel backend and progress handlers
num_workers <- 4
plan(multisession, workers = num_workers)
handlers(global = TRUE)
handlers("progress")
setwd("C:/Users/sebastiaan_verbessel/Downloads")
# Define directories and file paths
output_full <- "E:/covariates_full_dataset/"
dir.create(output_full, showWarnings = FALSE, recursive = TRUE)
# 2. Load grid and raster metadata
grid_512 <- st_read("512_pixel_grid.gpkg")
covariates_path <- "predictors_ARD2_filled.tif"
# Get CRS and transform grid
cov_crs <- crs(rast(covariates_path))
grid_512 <- st_transform(grid_512, cov_crs)
n_tiles <- nrow(grid_512)
poly_ids <- as.character(grid_512$id)
# Extract geometries as WKT strings and CRS string for safe transport
wkt_geoms <- st_as_text(st_geometry(grid_512))
crs_str <- st_crs(grid_512)$wkt
# 3. Parallel Execution Function
process_tiles <- function() {
p <- progressor(steps = n_tiles)
future_lapply(seq_len(n_tiles), function(i) {
p() # Signal progress update
poly_id <- poly_ids[i]
out_full_path <- file.path(output_full, paste0("Covariates_tile_id_", poly_id, ".tif"))
# Skip if file already exists
if (file.exists(out_full_path)) return("skipped")
# Configure terra INSIDE worker session with isolated temp directory & safe RAM limits
# Dividing memory allocation across workers prevents C++ out-of-memory crashes
worker_temp <- file.path(tempdir(), paste0("terra_worker_", Sys.getpid()))
dir.create(worker_temp, showWarnings = FALSE, recursive = TRUE)
terra::terraOptions(
memfrac = 0.15, # Allocates 15% RAM max per worker (60% total across 4 workers)
todisk = TRUE,
tempdir = worker_temp
)
res <- tryCatch({
# Reconstruct vector and raster connections cleanly inside worker
poly_vect <- terra::vect(wkt_geoms[i], crs = crs_str)
cov_rast_worker <- terra::rast(covariates_path)
# Crop & mask
cov_full <- terra::crop(cov_rast_worker, poly_vect, mask = TRUE)
# Only write if tile actually falls within raster extents / contains valid data
if (terra::ncell(cov_full) > 0 && !is.null(cov_full)) {
terra::writeRaster(cov_full, filename = out_full_path, overwrite = TRUE)
}
# Cleanup memory
rm(cov_full, cov_rast_worker, poly_vect)
"success"
}, error = function(e) {
# Log error message locally without terminating parallel run
cat(sprintf("\nError on tile %s: %s\n", poly_id, e$message))
"failed"
})
# Garbage collection
if (i %% 20 == 0) {
gc()
terra::tmpFiles(current = TRUE, orphan = TRUE, old = TRUE, remove = TRUE)
}
return(res)
}, future.seed = TRUE, future.packages = c("terra", "sf"))
}
# 4. Run process with progress bar
results <- with_progress({
process_tiles()
})
library(sf)
library(terra)
library(future)
library(future.apply)
library(progressr)
# 1. Set up parallel backend
# Reduced to 2 workers to prevent GDAL I/O bottlenecks on Windows
num_workers <- 2
plan(multisession, workers = num_workers)
handlers(global = TRUE)
handlers("progress")
setwd("C:/Users/sebastiaan_verbessel/Downloads")
# Output directory
output_full <- "E:/covariates_full_dataset/"
dir.create(output_full, showWarnings = FALSE, recursive = TRUE)
# 2. Read metadata on main thread
grid_512 <- st_read("512_pixel_grid.gpkg")
covariates_path <- "predictors_ARD2_filled.tif"
# Get raster info directly
cov_rast_main <- rast(covariates_path)
cov_crs <- crs(cov_rast_main)
grid_512 <- st_transform(grid_512, cov_crs)
# Extract Extents and IDs as simple data frames
# Passing raw bounding box coordinates avoids SpatVector/C++ serialization bugs
bboxes <- st_bbox(grid_512[1, ])
n_tiles <- nrow(grid_512)
tile_data <- lapply(seq_len(n_tiles), function(i) {
box <- st_bbox(grid_512[i, ])
list(
id = as.character(grid_512$id[i]),
xmin = box[["xmin"]],
xmax = box[["xmax"]],
ymin = box[["ymin"]],
ymax = box[["ymax"]]
)
})
# Close main raster handle explicitly
rm(cov_rast_main)
gc()
# 3. Parallel Execution
process_tiles <- function() {
p <- progressor(steps = n_tiles)
future_lapply(tile_data, function(item) {
p()
poly_id <- item$id
out_full_path <- file.path(output_full, paste0("Covariates_tile_id_", poly_id, ".tif"))
if (file.exists(out_full_path)) return("skipped")
# Configure isolated worker temp folder
worker_temp <- file.path(tempdir(), paste0("terra_w_", Sys.getpid()))
dir.create(worker_temp, showWarnings = FALSE, recursive = TRUE)
terra::terraOptions(memfrac = 0.2, todisk = TRUE, tempdir = worker_temp)
res <- tryCatch({
# Build extent bounding box directly from numbers
e <- terra::ext(item$xmin, item$xmax, item$ymin, item$ymax)
# Open raster connection inside worker
r <- terra::rast(covariates_path)
# Crop using spatial extent
cov_crop <- terra::crop(r, e)
if (!is.null(cov_crop) && terra::ncell(cov_crop) > 0) {
terra::writeRaster(cov_crop, filename = out_full_path, overwrite = TRUE)
}
# Clean up worker memory completely
rm(r, cov_crop)
gc()
"success"
}, error = function(e) {
"failed"
})
return(res)
}, future.seed = TRUE, future.packages = c("terra"))
}
# 4. Execute
results <- with_progress({
process_tiles()
})
