grid_512 <- st_read("512_pixel_grid.gpkg")
# Read metadata/CRS using terra pointer
#covariates_path <- "G:/Gedeelde drives/PRJ_SlimmeBeeldverwerking/PRJ_2026_SlimmeBeeldverwerking/Bewerkte covariabelen/predictors_ARD2.tif"
covariates_path <- "predictors_ARD2.tif"
covariates_rast <- rast(covariates_path)
# Read metadata/CRS using terra pointer
#covariates_path <- "G:/Gedeelde drives/PRJ_SlimmeBeeldverwerking/PRJ_2026_SlimmeBeeldverwerking/Bewerkte covariabelen/predictors_ARD2.tif"
covariates_path <- "predictors_ARD2_filled.tif"
covariates_rast <- rast(covariates_path)
# Ensure coordinate reference systems match
grid_512 <- st_transform(grid_512, crs(covariates_rast))
# Convert grid polygons once to spatVector
grid_vect <- vect(grid_512)
# Extract inputs into standard vectors/lists for safe passing across workers
n_tiles <- nrow(grid_512)
poly_ids <- as.character(grid_512$id)
# 3. Parallel Execution Function
process_tiles <- function() {
p <- progressor(steps = n_tiles)
future_lapply(seq_len(n_tiles), function(i) {
p() # Signal progress update
# Reload or load raster connection per worker process
cov_rast_worker <- rast(covariates_path)
poly <- grid_vect[i, ]
poly_id <- poly_ids[i]
out_full_path <- file.path(output_full, paste0("Covariates_tile_id_", poly_id, ".tif"))
# Skip if file already exists (optional safety optimization)
if (file.exists(out_full_path)) return(NULL)
# Crop & mask
cov_full <- crop(cov_rast_worker, poly, mask = TRUE)
writeRaster(cov_full, filename = out_full_path, overwrite = TRUE)
# Memory cleanup inside worker
rm(cov_full, cov_rast_worker)
if (i %% 25 == 0) {
gc()
tmpFiles(current = TRUE, orphan = TRUE, old = TRUE, remove = TRUE)
}
return(NULL)
}, future.seed = TRUE)
}
# 4. Run process with progress bar
with_progress({
process_tiles()
})
